# =========================================================================
# WOODPLAN AI - Environment Variables
# =========================================================================

# --- BACKEND SETTINGS ---
PORT=8000
HOST=0.0.0.0
# Allowed frontend CORS origins (e.g. your deployed Vercel domain)
FRONTEND_URL=http://localhost:5173

# --- DATABASE ---
# Local SQLite default:
DATABASE_URL=sqlite:///./woodplan.db
# Production PostgreSQL (Render / Supabase / Neon):
# DATABASE_URL=postgresql://woodplan_user:password@hostname:5432/woodplan

# --- AI PROVIDER & MULTIMODAL VISION ---
# Google Gemini API Key (or OpenAI / Anthropic key via adapter)
AI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
VISION_MODEL=gemini-1.5-flash

# --- STORAGE SETTINGS ---
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=50

# --- FRONTEND SETTINGS (for frontend/.env) ---
# Set this in Vercel to your deployed Render backend URL:
# VITE_API_URL=https://your-render-backend.onrender.com
VITE_API_URL=http://localhost:8000
